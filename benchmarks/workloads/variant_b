# ============================================================
# Variant B: Sustained Mixed Load Test
# ============================================================

workload=site.ycsb.workloads.CoreWorkload

# -----------------------------
# Dataset size
# -----------------------------
recordcount=2000
operationcount=8000

# -----------------------------
# Operation mix
# Realistic SaaS workload
# -----------------------------
readallfields=true
readproportion=0.6
updateproportion=0.25
insertproportion=0.15
scanproportion=0

# -----------------------------
# Access pattern
# More realistic distribution
# -----------------------------
requestdistribution=latest

# -----------------------------
# Connection
# -----------------------------
db=site.ycsb.db.DynamoDBClient
dynamodb.endpoint=http://localhost:8787

# -----------------------------
# Concurrency
# -----------------------------
threadcount=6

# -----------------------------
# Measurements
# -----------------------------
measurementtype=hdrhistogram
hdrhistogram.percentiles=50,90,95,99,99.9
