# ============================================================
# shvm-db Unified Benchmark Workload
#
# - Mix of Read, Update, Insert
# - Zipfian distribution to test hot keys/partitioning
# ============================================================

workload=site.ycsb.workloads.CoreWorkload

# -----------------------------
# Dataset size
# -----------------------------
recordcount=10000
operationcount=50000

# -----------------------------
# Operation mix
# -----------------------------
readallfields=true

# 50% Read, 30% Update, 20% Insert
readproportion=0.5
updateproportion=0.3
insertproportion=0.2
scanproportion=0

# -----------------------------
# Access pattern
# -----------------------------
requestdistribution=zipfian

# -----------------------------
# shvm-db connection
# -----------------------------
db=site.ycsb.db.DynamoDBClient
dynamodb.endpoint=http://localhost:8787
# shvmdb.table is auto-generated for isolation

# -----------------------------
# Concurrency
# -----------------------------
threadcount=4

# -----------------------------
# Measurements
# -----------------------------
measurementtype=hdrhistogram
hdrhistogram.percentiles=50,90,95,99,99.9
