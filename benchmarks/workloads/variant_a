# ============================================================
# Variant A: Hot Partition Stress Test
# ============================================================

workload=site.ycsb.workloads.CoreWorkload

# -----------------------------
# Dataset size (small to amplify hot keys)
# -----------------------------
recordcount=5000
operationcount=30000

# -----------------------------
# Operation mix
# Heavy writes to stress contention
# -----------------------------
readallfields=true
readproportion=0.4
updateproportion=0.4
insertproportion=0.2
scanproportion=0

# -----------------------------
# Access pattern
# Extreme skew
# -----------------------------
requestdistribution=zipfian
zipfianconstant=0.99

# -----------------------------
# Connection
# -----------------------------
db=site.ycsb.db.DynamoDBClient
dynamodb.endpoint=http://localhost:8787

# -----------------------------
# Concurrency
# -----------------------------
threadcount=8

# -----------------------------
# Measurements
# -----------------------------
measurementtype=hdrhistogram
hdrhistogram.percentiles=50,90,95,99,99.9
