# ============================================================
# Variant C: Concurrency Scaling
# ============================================================

workload=site.ycsb.workloads.CoreWorkload

# -----------------------------
# Dataset size
# -----------------------------
recordcount=1500
operationcount=6000

# -----------------------------
# Operation mix
# Read heavy to isolate contention
# -----------------------------
readallfields=true
readproportion=0.8
updateproportion=0.15
insertproportion=0.05
scanproportion=0

# -----------------------------
# Access pattern
# Uniform to avoid hot partition bias
# -----------------------------
requestdistribution=uniform

# -----------------------------
# Connection
# -----------------------------
db=site.ycsb.db.DynamoDBClient
dynamodb.endpoint=http://localhost:8787

# -----------------------------
# Concurrency
# Change this between runs:
# 2 → 4 → 8 → 12
# -----------------------------
threadcount=4

# -----------------------------
# Measurements
# -----------------------------
measurementtype=hdrhistogram
hdrhistogram.percentiles=50,90,95,99,99.9
