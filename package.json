{
	"name": "shvm-db",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@10.9.2",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "cd compat-test && npm run test",
		"test:local": "vitest run",
		"test:live": "TEST_URL=https://db.shvm.in vitest run",
		"cf-typegen": "wrangler types",
		"benchmark:setup": "chmod +x benchmarks/*.sh && chmod +x benchmarks/ycsb-dist/bin/ycsb.sh",
		"benchmark:compat": "./benchmarks/run_dynamo_compat.sh",
		"benchmark:run": "./benchmarks/run_benchmark.sh",
		"benchmark:live": "./benchmarks/run_benchmark.sh --endpoint https://db.shvm.in/api",
		"deploy:live": "wrangler deploy && echo 'Live deployment active. Update your client config to point to the deployed URL.'"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.18",
		"@cloudflare/workers-types": "^4.20240208.0",
		"@types/node": "^24.10.1",
		"typescript": "^5.5.2",
		"vitest": "^3.0.0",
		"wrangler": "^4.51.0"
	},
	"dependencies": {
		"zod": "^4.3.6"
	}
}
